# ---- Core ----
NODE_ENV=development
PORT=5000
HOST=0.0.0.0
# Terminate TLS in front of the API and keep this on so rate limiting sees real client IPs.
TRUST_PROXY=true

MONGO_URI=mongodb://localhost:27017/ai-interview-platform

# Required in production. Generate with: openssl rand -base64 48
JWT_SECRET=
JWT_EXPIRE=7d

# ---- CORS ----
CLIENT_URL=http://localhost:3001
# Optional comma separated allowlist, overrides CLIENT_URL when set.
CORS_ORIGINS=

# Serve client/dist from the API process (single-container deployments).
SERVE_CLIENT=false

# Password-less demo logins and demo tokens. Must be false in production.
DEMO_MODE=true

# ---- Rate limits (requests per 15 minutes) ----
AUTH_RATE_LIMIT_MAX=20
API_RATE_LIMIT_MAX=600
CODE_RUN_RATE_LIMIT_MAX=60

# ---- Code execution ----
# docker | host | auto | disabled. Production must use docker (or disabled).
CODE_EXECUTION_RUNNER=auto
CODE_EXECUTION_TIMEOUT_MS=8000
CODE_EXECUTION_MEMORY_MB=256
CODE_EXECUTION_CPUS=1

# ---- Auth providers ----
GOOGLE_CLIENT_ID=

# ---- AI providers (optional; static question bank is used when empty) ----
GEMINI_API_KEY=
OPENAI_API_KEY=
VAPI_API_KEY=
VAPI_ASSISTANT_ID=

# ---- Razorpay (Dashboard > Account & Settings > API Keys) ----
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Dashboard > Settings > Webhooks, subscribe to payment.captured and payment.failed
# pointing at POST <server>/api/payments/webhook
RAZORPAY_WEBHOOK_SECRET=
