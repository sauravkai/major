# Vite only exposes VITE_* variables, and they are baked into the bundle at build time.

# Leave empty to call the API on the same origin (/api behind a reverse proxy).
VITE_API_URL=
# Leave empty to open the socket against the page origin.
VITE_SOCKET_URL=

# Google Identity Services client id; must match GOOGLE_CLIENT_ID on the server.
VITE_GOOGLE_CLIENT_ID=

# Vapi public (browser) key for the AI voice interview.
VITE_VAPI_PUBLIC_KEY=
